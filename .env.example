# Clinic System Pro v5 - Production Environment Contract

FLASK_ENV=production
PORT=5000

SECRET_KEY=
JWT_SECRET_KEY=

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://:PASSWORD@HOST:6379/0

CORS_ALLOWED_ORIGINS=https://app.example.com

# SMTP outbound destination policy. Exact operator-approved DNS names and ports.
# Empty values fail closed: SMTP delivery remains disabled until configured.
SMTP_ALLOWED_HOSTS=
SMTP_ALLOWED_PORTS=

# Phase 6 environment-specific SMTP policy for compose.phase6.yaml.
PHASE6_SMTP_ALLOWED_HOSTS=
PHASE6_SMTP_ALLOWED_PORTS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback

OPENAI_API_KEY=
INTEGRATION_ENCRYPTION_KEY=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

UPLOAD_FOLDER=
STORAGE_ROOT=
STORAGE_PUBLIC_BASE_URL=

BACKUP_ROOT=
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_RECOVERY_POINTS=1


# Integration credential encryption domain (Fernet)
INTEGRATION_ENCRYPTION_KEY_VERSION=1
INTEGRATION_ENCRYPTION_LEGACY_KEYS={}

# Encrypted database-backup domain (AES-256-GCM)
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_VERSION=1