# Clinic System Pro v5 - Production Environment Contract

FLASK_ENV=production
PORT=5000

SECRET_KEY=
JWT_SECRET_KEY=

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://:PASSWORD@HOST:6379/0

# Distributed outbound circuit breaker.
# State is shared in Redis across backend replicas. Redis loss degrades the
# breaker fail-open; the existing provider timeout/security controls still apply.
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_OPEN_SECONDS=30
# Must exceed the longest normal provider-call timeout protected by the breaker.
CIRCUIT_BREAKER_PROBE_LEASE_SECONDS=60
CIRCUIT_BREAKER_STATE_TTL_SECONDS=3600

CORS_ALLOWED_ORIGINS=https://app.example.com

# SMTP outbound destination policy. Exact operator-approved DNS names and ports.
# Empty values fail closed: SMTP delivery remains disabled until configured.
SMTP_ALLOWED_HOSTS=
SMTP_ALLOWED_PORTS=

# Platform-owned security email used for password recovery.
# The host/port must also be present in the SMTP allowlists above.
PLATFORM_EMAIL_HOST=
PLATFORM_EMAIL_PORT=587
PLATFORM_EMAIL_USERNAME=
PLATFORM_EMAIL_PASSWORD=
PLATFORM_EMAIL_FROM_EMAIL=
PLATFORM_EMAIL_USE_TLS=true
PLATFORM_EMAIL_USE_SSL=false

# Trusted HTTPS frontend/deep-link target. Reset credentials are appended
# as a URL fragment rather than derived from the request Host header.
PASSWORD_RESET_PUBLIC_URL=https://app.example.com/reset-password

# Password-security abuse controls.
AUTH_CHANGE_PASSWORD_RATE_LIMIT=5 per minute
AUTH_PASSWORD_RESET_REQUEST_RATE_LIMIT=5 per minute
AUTH_PASSWORD_RESET_CONFIRM_RATE_LIMIT=10 per minute
AUTH_PASSWORD_CHANGE_FAILURE_WINDOW_SECONDS=900
AUTH_PASSWORD_CHANGE_MAX_FAILURES=5
AUTH_PASSWORD_RESET_TOKEN_TTL_SECONDS=900
AUTH_PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
AUTH_PASSWORD_RESET_REQUEST_MAX_PER_HOUR=3
AUTH_PASSWORD_RESET_REQUEST_MAX_PER_DAY=8
AUTH_PASSWORD_RESET_CLAIM_TTL_SECONDS=60

# SUPER_ADMIN recovery MFA rollout policy:
# disabled -> if_enrolled -> required.
# Keep disabled until an MFA recovery-factor provider is registered.
AUTH_SUPER_ADMIN_PASSWORD_RESET_MFA_POLICY=disabled
AUTH_SUPER_ADMIN_PASSWORD_RESET_MFA_MAX_FAILURES=5

# Phase 6 environment-specific SMTP policy for compose.phase6.yaml.
PHASE6_SMTP_ALLOWED_HOSTS=
PHASE6_SMTP_ALLOWED_PORTS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback

OPENAI_API_KEY=
INTEGRATION_ENCRYPTION_KEY=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

UPLOAD_FOLDER=
STORAGE_ROOT=
STORAGE_PUBLIC_BASE_URL=

BACKUP_ROOT=
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_RECOVERY_POINTS=1


# Integration credential encryption domain (Fernet)
INTEGRATION_ENCRYPTION_KEY_VERSION=1
INTEGRATION_ENCRYPTION_LEGACY_KEYS={}

# Encrypted database-backup domain (AES-256-GCM)
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_VERSION=1
