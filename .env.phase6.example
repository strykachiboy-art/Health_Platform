# Clinic System Pro - Compose Phase 6 / Phase 9 interpolation inputs
# Copy to .env.phase6 locally. Fill every required blank before use.
# This example intentionally contains no real credentials or secrets.

PHASE6_POSTGRES_DB=
PHASE6_POSTGRES_USER=
PHASE6_POSTGRES_PASSWORD=

PHASE6_APP_IMAGE=
PHASE6_FLASK_ENV=production
PHASE6_SECRET_KEY=
PHASE6_JWT_SECRET_KEY=

# Internal Compose-network Redis URL for the bundled Redis service.
PHASE6_REDIS_URL=redis://redis:6379/0

PHASE6_CORS_ALLOWED_ORIGINS=

PHASE6_STORAGE_ROOT=/data/storage
PHASE6_BACKUP_ROOT=/data/backups
PHASE6_STORAGE_PUBLIC_BASE_URL=
PHASE6_UPLOAD_FOLDER=/data/storage/uploads

PHASE6_BACKUP_RETENTION_DAYS=30
PHASE6_BACKUP_MIN_RECOVERY_POINTS=1

PHASE6_INTEGRATION_ENCRYPTION_KEY=
PHASE6_BACKUP_ENCRYPTION_KEY=
PHASE6_BACKUP_ENCRYPTION_KEY_VERSION=1
