          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"operation_queue_entry\" (\"operation_id\" TEXT NOT NULL, \"operation_type\" TEXT NOT NULL, \"idempotency_key\" TEXT NOT NULL UNIQUE, \"owner_user_id\" TEXT NULL, \"clinic_context_id\" TEXT NULL, \"lifecycle_state\" TEXT NOT NULL DEFAULT 'queued', \"attempts_completed\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"next_attempt_at\" INTEGER NULL, \"last_failure_category\" TEXT NULL, PRIMARY KEY (\"operation_id\"));"
