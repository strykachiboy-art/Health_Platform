# Copy this file to .env locally, then fill the blank values.
# Never commit a populated .env file.
#
# Use URL-safe hex values for POSTGRES_PASSWORD and REDIS_PASSWORD
# because they are embedded in connection URLs.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Generate distinct application/encryption keys:
#   SECRET_KEY / JWT_SECRET_KEY:
#     python -c "import secrets; print(secrets.token_hex(32))"
#   INTEGRATION_ENCRYPTION_KEY:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   BACKUP_ENCRYPTION_KEY:
#     python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
#
# The integration and backup encryption keys must be different.
# Set CORS_ALLOWED_ORIGINS to the exact trusted frontend origin(s).

POSTGRES_DB=clinic_system
POSTGRES_USER=clinic
POSTGRES_PASSWORD=
REDIS_PASSWORD=

SECRET_KEY=
JWT_SECRET_KEY=
CORS_ALLOWED_ORIGINS=https://app.example.com

INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY_VERSION=1
INTEGRATION_ENCRYPTION_LEGACY_KEYS={}

BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_VERSION=1
